      "id": "f3b4ddd3-7a3d-4b10-af20-b997e73e5962",
      "name": "Read evaluation files"
    },
    {
      "parameters": {
        "jsCode": "const NOISE_MARGIN = 3.0;\n\nconst items = $input.all();\nconst files = {};\nfor (let i = 0; i < items.length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  files[items[i].json.fileName] = JSON.parse(buf.toString('utf8'));\n}\n\nconst inp = $('Inputs').first().json;\nconst liveName = inp.live;\nconst candName = inp.candidate;\nconst cases = files['evaluation_set_30.json'];\nconst n = cases.length;\n\nfunction normRule(s) {\n  s = String(s ?? '').trim().toLowerCase().replace(/\\.+$/, '');\n  if (s.startsWith('none') || s === '' || s === 'n/a') return 'none';\n  return s;\n}\nfunction ruleMatch(expected, predicted) {\n  const e = normRule(expected), p = normRule(predicted);\n  if (e === 'none' || p === 'none') return e === p;\n  return e === p || e.includes(p) || p.includes(e);\n}\nfunction score(version) {\n  const runs = files[`evaluation_${version}.json`].all_runs;\n  const risk = [], rule = [];\n  const perCase = new Array(n).fill(0);\n  for (const run of runs) {\n    let rOk = 0, uOk = 0;\n    run.results.forEach((r, i) => {\n      if (r.match) { rOk++; perCase[i]++; }\n      if (ruleMatch(cases[i].policy_rule, r.predicted_policy_rule)) uOk++;\n    });\n    risk.push(rOk / n * 100);\n    rule.push(uOk / n * 100);\n  }\n  const avg = a => a.reduce((x, y) => x + y, 0) / a.length;\n  return { runs: runs.length, risk: avg(risk), rule: avg(rule), perCase };\n}\n\nconst live = score(liveName);\nconst cand = score(candName);\n\nconst reasons = [];\nif (cand.risk < live.risk - NOISE_MARGIN)\n  reasons.push(`risk-level accuracy lower: ${cand.risk.toFixed(1)}% vs live ${live.risk.toFixed(1)}%`);\nif (cand.rule < live.rule - NOISE_MARGIN)\n  reasons.push(`policy-rule match lower: ${cand.rule.toFixed(1)}% vs live ${live.rule.toFixed(1)}%`);\n\nconst regressions = [];\nfor (let i = 0; i < n; i++) {\n  if (live.perCase[i] === live.runs && cand.perCase[i] === 0) {\n    regressions.push(`${cases[i].heading} (pair ${cases[i].pair_id})`);\n  }\n}\nif (regressions.length)\n  reasons.push(`${regressions.length} stable case(s) regressed (live right every run, candidate never)`);\n\nreturn [{\n  json: {\n    live: liveName,\n    candidate: candName,\n    live_risk: Number(live.risk.toFixed(1)),\n    live_rule: Number(live.rule.toFixed(1)),\n    cand_risk: Number(cand.risk.toFixed(1)),\n    cand_rule: Number(cand.rule.toFixed(1)),\n    regressions: regressions.length,\n    decision: reasons.length ? 'BLOCK' : 'PASS',\n    reasons: reasons.join('; ')\n  }\n}];"
      },
